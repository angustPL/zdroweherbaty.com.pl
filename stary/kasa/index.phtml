<script>
$('button[type=submit]').click((e) => {
  $(this).prop('disabled', true);
    var isValid = true;
    if (!klientValidate($('#form-klient').serialize())) {
      isValid = false;
    }
    if (!dostawaValidate()) {
      if (isValid) scrollToDostawa();
      isValid = false;
    }
    if (!platnoscValidate()) {
      if (isValid) scrollToPlatnosc();
      isValid = false;
    }

    if (!isValid) e.preventDefault();

    $(this).removeProp('disabled');
    console.log(isValid);
});
</script>