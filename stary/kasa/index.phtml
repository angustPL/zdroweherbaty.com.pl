statusFaktura = () => {
    if ($('#subform-dokument :checked').val() == 'faktura') {
        $('#subform-faktura:hidden').slideDown();
    } else {
        $('#subform-faktura:visible').slideUp().find('.errors').remove();
    }
};
$('#subform-dokument input').change(statusFaktura);
