<script type="text/javascript">
var scrollToPlatnosc = () => {
    $('html, body').animate({
        scrollTop: $("#platnosc-container").offset().top - $('.navbar').outerHeight()
    }, 500);
}
var setPlatnosc = function(val_platnosc) {
    var data = null;
    if (val_platnosc) {
        data = {'platnosc': val_platnosc};
    }
    $.ajax({
        type: 'POST',
        url: '<?= $this->url(array(
            'controller'=>'kasa',
            'action'=>'platnosc',
            'format'=>'html'), 'default', true) ?>',
        data: data,
        success: function(data) {
            $('#platnosc-container').html(data);
        },
        error: function(error) {
            alert('Nie udało się zapisać wyboru');
            console.log(error);
        }
    });
}
var platnoscValidate = (data) => {
    var validate = true;
    if (!$('input[name=platnosc]:checked').val()) {
        $('.platnosc_error').text('Proszę wybrać sposób płatności');
        validate = false;
    } else $('.platnosc_error').empty();
    return validate;
}
$('input[name=platnosc]').change(function() {
    setPlatnosc($(this).val());
});
</script>