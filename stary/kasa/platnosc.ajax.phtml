<legend>Sposób płatności</legend>
<div class="errors platnosc_error"></div>
<table class="w-100">
    <tbody>
        <tr>
            <td>

            <?php foreach ($this->opcje as $opcja) : ?>
                <div class="form-check my-2">
                    <input class="form-check-input" type="radio" name="platnosc" id="platnosc<?= $opcja['value'] ?>" value="<?= $opcja['value'] ?>"<?= ($opcja['value'] == $this->platnoscCheck['ID']) ? ' checked' : '' ?>>
                    <label class="form-check-label w-100" for="platnosc<?= $opcja['value'] ?>">
